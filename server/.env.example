# Server
PORT=5000
NODE_ENV=development
# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/novara
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed by CORS in development (Vite runs on 5173)
CLIENT_ORIGIN=*
# Serve client/dist from Express (single port). Defaults to true when NODE_ENV=production
SERVE_CLIENT=false
