# Server
PORT=5000
NODE_ENV=development
# Local MongoDB or MongoDB Atlas connection string.
# Leave it commented out in development to use the built-in dev database (saved to server/.data).
# MONGODB_URI=mongodb://127.0.0.1:27017/novara
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/novara
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed by CORS in development (Vite runs on 5173)
CLIENT_ORIGIN=*
# Serve client/dist from Express (single port). Defaults to true when NODE_ENV=production
SERVE_CLIENT=false
# Create demo@novara.app / demo1234 with sample data on startup (default: true in dev, false in production)
# SEED_DEMO=true
