# Copy this file to server/.env and fill in the values. Never commit server/.env.

# ── Required ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Put the database name before the "?", e.g. ...mongodb.net/novara?retryWrites=true&w=majority
# URL-encode special characters in the password (@ : / ? # [ ] %).
MONGO_URI=

# Long random string used to sign login tokens (min 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=5000
# How long a login lasts
JWT_EXPIRES_IN=7d

# Only needed when the React app is hosted on a different domain than the API
# (comma-separated list of exact origins). Leave empty for a single deployment.
CLIENT_ORIGIN=

# Number of reverse proxies in front of the app, used to read the real client IP
# for rate limiting. Defaults to 1 in production (Render, Railway, Heroku, Fly) and
# false otherwise. Use false if the server is exposed directly to the internet.
# TRUST_PROXY=1

# Serve client/dist from Express. Defaults to true whenever client/dist exists.
# SERVE_CLIENT=true
