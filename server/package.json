{
  "name": "novara-server",
  "version": "1.0.0",
  "private": true,
  "description": "Novara REST API (Express + MongoDB/Mongoose)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --no-warnings=ExperimentalWarning src/index.js",
    "start": "node --no-warnings=ExperimentalWarning src/index.js",
    "postinstall": "node src/embedded-db/patch.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@rckflr/easydb-server": "0.4.0",
    "better-sqlite3": "file:./src/embedded-db/better-sqlite3"
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
