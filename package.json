{
  "name": "novara",
  "private": true,
  "version": "1.0.0",
  "description": "Novara: inventory, orders and analytics for small product businesses (MERN).",
  "scripts": {
    "postinstall": "npm install --prefix server && npm install --prefix client --include=dev",
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:server\" \"npm:client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "seed:demo": "npm run seed:demo --prefix server"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
